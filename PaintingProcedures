unit PaintingProcedures;

interface

uses
   GraphABC, TypesAndConst;

procedure SquareMethod(A, B, C: tPoint; color: System.Drawing.Color);

{==================================================================}

implementation

procedure SquareMethod(A, B, C: tPoint; color: System.Drawing.Color);
var
   maxPoint, minPoint: tPoint;
   i, j: integer;
   aSide, bSide, cSide: integer;
begin
   maxPoint.x := Max(A.x, B.x, C.x);
   maxPoint.y := Max(A.y, B.y, C.y);
   minPoint.x := Min(A.x, B.x, C.x);
   minPoint.y := Min(A.y, B.y, C.y);
   for i := minPoint.x to maxPoint.x do
      for j := minPoint.y to maxPoint.y do begin
         aSide := (A.y - B.y)*i + (B.x - A.x)*j + (A.x*B.y - B.x*A.y);
         bSide := (B.y - C.y)*i + (C.x - B.x)*j + (B.x*C.y - C.x*B.y);
         cSide := (C.y - A.y)*i + (A.x - C.x)*j + (C.x*A.y - A.x*C.y);
         if (aSide >= 0) and (bSide >= 0) and (cSide >= 0) or (aSide < 0) and (bSide < 0) and (cSide < 0) then
            SetPixel(i, j, clYellow);
      end;
end;

end.
